# ── Leads do formulário de contato (/api/lead) ─────────────────────────────
# Configure pelo menos um destino. Sem nenhum, em produção o formulário oferece
# ao visitante um e-mail pré-preenchido.

# 1) E-mail via SMTP — caixa da Hostinger (hPanel → Emails → contato@gldntech.com.br)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=contato@gldntech.com.br
SMTP_PASS=
# Opcional: para quem vai o aviso de lead (padrão: SMTP_USER). Aceita vários, separados por vírgula.
LEAD_TO=

# 2) Webhook (opcional) — Make, Zapier, Power Automate, n8n, CRM.
LEAD_WEBHOOK_URL=
# Opcional: enviado no header x-webhook-secret.
LEAD_WEBHOOK_SECRET=
